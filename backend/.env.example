# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NUNCA deve ser versionado.

# Conexao com o PostgreSQL local (docker compose)
DATABASE_URL=postgres://mente_ativa:mente_ativa_dev@localhost:5432/mente_ativa

# Porta da API Express
PORT=3000

# Segredo usado para assinar os JWT. Gere um valor aleatorio com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-48-bytes

# Validade do token
JWT_EXPIRES_IN=7d

# Origens permitidas no CORS. Use "*" apenas em desenvolvimento.
# Para varias origens, separe por virgula: http://localhost:8081,http://192.168.0.10:8081
CORS_ORIGIN=*

# Usuario de teste criado por "npm run db:setup"
SEED_USER_NAME=Usuario Teste
SEED_USER_EMAIL=teste@menteativa.com
SEED_USER_PASSWORD=Senha@123

# pgAdmin - interface web do banco (http://localhost:5050)
# Essas credenciais sao usadas apenas para entrar no pgAdmin, nao no PostgreSQL.
PGADMIN_DEFAULT_EMAIL=admin@menteativa.com
PGADMIN_DEFAULT_PASSWORD=MenteAtiva@2026
PGADMIN_PORT=5050
